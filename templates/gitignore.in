# Build output and derived data: never committed. (The game's own files below are kept out by default so a public repository does not redistribute them; remove those lines if you want a self-contained repository.)
/build/
/ghidra/
/analysis/
/docs/gfx/*/
/extracted/
__pycache__/
# Supplied game data: never committed (see README.md for how to supply it).
/originals/
/dumps/
/reference/
/*.prg
/.sync-state
.DS_Store
*.swp
*~
# Kick working copies next to the source
phase1/src/build/
phase2/src/build/
/tools/ghidra/exporter/
*.log
