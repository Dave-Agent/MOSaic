# justfile: thin. Generic recipes come from framework/recipes.just; the MOSaic skill's scripts are called through `skill`.
set allow-duplicate-recipes := true
set shell := ["bash", "-euo", "pipefail", "-c"]      # the recipes use bash arrays: on Windows run just from Git Bash or WSL
skill := env_var_or_default("MOSAIC", home_directory() / ".claude/skills/mosaic")
rom_dir := shell('python3 -B "$1"', skill / "scripts/trace/rom_dir.py")
# The phase the bare commands work on: ACTIVE_PHASE in project.config (1 until phase 2 starts; set it to 2 then). Every command below takes the phase as its argument: `just verify`, `just verify 2`.
active_phase := `bash -c 'source project.config 2>/dev/null; echo "${ACTIVE_PHASE:-1}"'`
import 'framework/recipes.just'

default:
    @just --list

# Check the tools this project needs are installed (run first on a new machine).
env:
    @python3 -B {{skill}}/scripts/check_env.py --role run --role disk --role trace --role ghidra

# Check the layout rules: no game binaries tracked, originals read-only with a recorded hash.
layout:
    python3 -B {{skill}}/scripts/check_layout.py --root .

# Stage 2: DUMP_COUNT RAM dumps at DUMP_PC, real speed, from a read-only scratch copy of the medium. Each takes about a minute (five: ~6 minutes): run it in the background.
# project.config: HANDOFF_MEDIA, DUMP_PC, DUMP_COUNT, and for a title/menu that waits for a key or fire: DUMP_STEPS ("ADDR=> ADDR EA EA;;ADDR=CMD" patches run in order at each address, `;;` between steps) and DUMP_FEED.
dumps:
    #!/usr/bin/env bash
    set -euo pipefail
    . ./project.config
    : "${DUMP_PC:?set DUMP_PC in project.config: the address the dumps are taken at (references/new_game.md stage 2)}"
    mkdir -p dumps
    args=()
    if [ -n "${DUMP_STEPS:-}" ]; then
        IFS=$'\n' read -r -d '' -a parts < <(printf '%s\0' "${DUMP_STEPS//;;/$'\n'}") || true
        for p in "${parts[@]}"; do args+=(--step "$p"); done
    fi
    [ -n "${DUMP_FEED:-}" ] && args+=(--feed "$DUMP_FEED")
    for i in $(seq 1 "${DUMP_COUNT:-5}"); do
        python3 -B {{skill}}/scripts/vice/vice_handoff.py --root . --media "$HANDOFF_MEDIA" --handoff "$DUMP_PC" --no-warp ${args[@]+"${args[@]}"} --out dumps/at_dump_$i.bin --timeout 400
    done

# A timing-critical loader leaves single-bit noise that differs per run in VICE: keep the value most dumps agree on.
vote:
    python3 -B {{skill}}/scripts/reference/vote_dumps.py --root . --out dumps/voted.bin dumps/at_dump_*.bin || true

# Run the depacker in the skill's tracer from the voted image to HANDOFF_PC and dump RAM there (dumps/handoff.bin is the 64 KB RAM; handoff_state.bin adds VIC registers, colour RAM, $DD00).
# If nothing needs depacking, DUMP_PC and HANDOFF_PC are the same address: this recipe then just copies the voted image.
decrunch:
    #!/usr/bin/env bash
    set -euo pipefail
    . ./project.config
    : "${DUMP_PC:?}" "${HANDOFF_PC:?set HANDOFF_PC in project.config, the address of the depacker exit}"
    if [ "$DUMP_PC" = "$HANDOFF_PC" ]; then cp dumps/voted.bin dumps/handoff.bin; echo "DUMP_PC = HANDOFF_PC: nothing to depack, handoff.bin is the voted dump"; exit 0; fi
    mkdir -p build/trace
    gcc -O2 -o build/trace/c64trace {{skill}}/scripts/trace/c64trace.c
    rm -f build/trace/h.*
    build/trace/c64trace --ram dumps/voted.bin --rom-dir {{rom_dir}} --out build/trace/h --pc "$DUMP_PC" --sp "${DECRUNCH_SP:-fc}" --p "${DECRUNCH_P:-34}" --port "${DECRUNCH_PORT:-34}" --frames 400 --dump-at "$HANDOFF_PC" --dump dumps/handoff_state.bin
    head -c 65536 dumps/handoff_state.bin > dumps/handoff.bin

# Derive the reference: the RAM range REF_KEEP at the hand-off, patched by tools/reference.spec, with its SHA-256.
reference:
    #!/usr/bin/env bash
    set -euo pipefail
    . ./project.config
    if [ "${REFERENCE_IS_RAW:-true}" = "true" ]; then
        python3 -B {{skill}}/scripts/reference/make_reference.py --root . --in dumps/handoff.bin --write
    else
        # PRG target: the reference is the PRG file itself (header included), copied from originals/ with its SHA-256 recorded.
        case "$HANDOFF_MEDIA" in *.prg|*.PRG) ;; *) echo "REFERENCE_IS_RAW=false needs HANDOFF_MEDIA to be a .prg file (it is $HANDOFF_MEDIA)" >&2; exit 1;; esac
        mkdir -p "$(dirname "$REFERENCE_PRG")"; rm -f "$REFERENCE_PRG"; cp "$HANDOFF_MEDIA" "$REFERENCE_PRG"; chmod a-w "$REFERENCE_PRG"
        python3 -c 'import hashlib, os, sys; print("%s  %s" % (hashlib.sha256(open(sys.argv[1], "rb").read()).hexdigest(), os.path.basename(sys.argv[1])))' "$REFERENCE_PRG" > "${REF_SHA_FILE:-reference.sha256}"
        cat "${REF_SHA_FILE:-reference.sha256}"
    fi

# The whole derivation from the medium to the reference.
derive: dumps vote decrunch reference

# Stage 5a: run the game in the tracer from the hand-off with seeded fuzz (joystick presses fuzzed unless SEED_JOY1/SEED_JOY2 hold a value) and write the Ghidra seeds from what executed.
seeds:
    #!/usr/bin/env bash
    set -euo pipefail
    . ./project.config
    : "${HANDOFF_PC:?}"
    mkdir -p build/trace tools/ghidra
    [ -x build/trace/c64trace ] || gcc -O2 -o build/trace/c64trace {{skill}}/scripts/trace/c64trace.c
    rm -f build/trace/cov.*
    # Input: an empty SEED_JOY1/SEED_JOY2 leaves that joystick to the tracer's random presses (a menu needs them); a value holds it (ff = nothing pressed).
    # SEED_EXTRA adds tracer arguments, e.g. --joy2-at 100=ef --joy2-at 110=ff (fire pulsed at frame 100).
    inp=()
    [ -n "${SEED_JOY1:-}" ] && inp+=(--joy1 "$SEED_JOY1")
    [ -n "${SEED_JOY2:-}" ] && inp+=(--joy2 "$SEED_JOY2")
    : > build/trace/seed_runs.txt
    for s in $(seq 1 "${SEED_RUNS:-6}"); do
        # shellcheck disable=SC2086  # SEED_EXTRA is a list of arguments on purpose
        out=$(build/trace/c64trace --ram dumps/handoff.bin --rom-dir {{rom_dir}} --out build/trace/cov --pc "$HANDOFF_PC" --sp "${DECRUNCH_SP:-fc}" --p "${DECRUNCH_P:-34}" --port 35 --frames "${SEED_FRAMES:-6000}" --seed $s --chaos 6 ${inp[@]+"${inp[@]}"} ${SEED_EXTRA:-} 2>&1) || true
        case "$(echo "$out" | tail -1)" in *"distinct opcode addresses"*) ;; *) echo "$out" >&2; echo "the tracer failed (seed $s): see the message above (ROM folder: {{rom_dir}}; set VICE_ROM_DIR if that is wrong)" >&2; exit 1;; esac
        echo "$out" | tail -1 | tee -a build/trace/seed_runs.txt
    done
    # The same address count in every run means the input never changed what the game did (stuck on a title or menu?).
    if [ "$(awk '{for(i=1;i<NF;i++) if($(i+1)=="distinct") print $i}' build/trace/seed_runs.txt | sort -u | wc -l)" = 1 ] && [ "$(wc -l < build/trace/seed_runs.txt)" -gt 2 ]; then
        echo "WARNING: every run executed the same number of addresses: the game probably never got past a title or menu. Leave SEED_JOY1/SEED_JOY2 empty, or press what it waits for with SEED_EXTRA (--joy2-at FRAME=VALUE ...)." >&2
    fi
    python3 -B {{skill}}/scripts/ghidra/make_seeds.py --root . --reference "$REFERENCE_PRG" $([ "${REFERENCE_IS_RAW:-true}" = true ] && echo "--base ${LOAD_ADDRESS#0x}" || echo --prg) --out tools/ghidra/seeds.txt --entry "$HANDOFF_PC:hand-off" --vectors dumps/handoff.bin --edges build/trace/cov.edges --executed build/trace/cov.flags

# First conversion step after the first byte-identical build: name the hardware registers with the libs (names only; the gate must stay green).
libs:
    python3 -B {{skill}}/scripts/apply_libs.py --root . --phase 1
    @echo "dry run above: apply with  just libs-apply  (it re-runs verify)"

libs-apply:
    python3 -B {{skill}}/scripts/apply_libs.py --root . --phase 1 --write
    just verify

# The anonymous-label limits (rules.md): fails on !+++ / !--- or a reference over the limits. `anon_labels.py` alone lists the candidates.
anon-check:
    python3 -B {{skill}}/scripts/anon_labels.py --root . --phase 1 --check

# Second conversion step (after libs-apply, before any slice): convert the local labels that qualify to anonymous ones; the gate must stay green.
anon-apply:
    python3 -B {{skill}}/scripts/anon_labels.py --root . --phase 1 --write
    just verify
    just anon-check

# The comment rules (rules.md): width, label-line summary, data-row comments. A tools/comment_baseline.tsv makes it a ratchet.
comment-check:
    python3 -B {{skill}}/scripts/comment_check.py --root . --phase 1

# How far phase 1 is, per area: a bar of the clean share (raw operands, placeholder and provisional names left), about two seconds per area; saved for `just status`.
gauge:
    python3 -B {{skill}}/scripts/gauge.py --root . --phase 1

# Stage 5b: import the reference into Ghidra, seed it, export Kick Assembler source into ghidra/ (the landing zone: never phase1/src).
ghidra:
    bash {{skill}}/scripts/ghidra/run.sh .

# Per-frame samples of variables under a scripted input (rung 3 evidence): just trace-run 'NAME_A NAME_B' '--joy2-at 5=ef' 300
trace-run vars inputs="" frames="300":
    . ./project.config; python3 -B {{skill}}/scripts/trace/sample_report.py --root . --phase 1 {{vars}} --run -- --ram dumps/handoff.bin --rom-dir {{rom_dir}} --pc "${TRACE_ENTRY:-$HANDOFF_PC}" --sp "${TRACE_SP:-${DECRUNCH_SP:-fc}}" --p "${TRACE_P:-${DECRUNCH_P:-34}}" --port "${TRACE_PORT:-35}" --frames {{frames}} --seed 1 --chaos 6 --joy1 ff {{inputs}}

# Render the game's graphics (character set, every sprite block of the VIC bank, the screen) as PNGs into docs/gfx/ with docs/gfx/index.md; extra options pass through, e.g. just gfx --sprites 30:57:3 --columns 0,1,2 --label player (scripts/render/README.md). Look at the pictures; attach one to a naming question.
gfx *args:
    python3 -B {{skill}}/scripts/render/gfx_sheets.py --root . {{args}}

# A research note: the skeleton of docs/research/<topic>.md for a researcher's answer to ONE specific question (references/research.md, "Research on demand"): just research-new 'scoring' 'How does the manual say extra lives are awarded?'
research-new topic question:
    python3 -B {{skill}}/scripts/research/note.py new --root . --topic '{{topic}}' --question '{{question}}'

# Check the research notes: NON-AUTHORITATIVE header, question, date, a source on every prior, conflicts and not-found sections.
research-check:
    python3 -B {{skill}}/scripts/research/note.py check --root .

# Every gate a slice must pass (verify, comment-check, anon-check, unreferenced, p1_complete, sentinel hints): just slice-check [--range LO-HI] [--allow-marked]
slice-check *args:
    python3 -B {{skill}}/scripts/slice.py check --root . {{args}}

# The brief for the Challenger, a read-only agent that reviews a slice's diff before it merges (references/challenger.md): just review-brief NAME
review-brief name:
    python3 -B {{skill}}/scripts/review.py brief {{name}} --root .

# What a review of a slice would test and cost, from its diff alone (no tokens): just review-risk NAME
review-risk name:
    python3 -B {{skill}}/scripts/review.py risk {{name}} --root .

# Validate the Challenger's record and store it as docs/reviews/NAME-<diff hash>.md: just review-record NAME FILE
review-record name file:
    python3 -B {{skill}}/scripts/review.py record {{name}} {{file}} --root .

# The merge gate's check on its own: is there a passing review record for the slice's current diff? just review-check NAME
review-check name:
    python3 -B {{skill}}/scripts/review.py check {{name}} --root .

# Scratch copy of the project for a slice (an agent works there): just slice-start NAME
slice-start name:
    python3 -B {{skill}}/scripts/slice.py start {{name}} --root .

# What a slice has done so far (commits, uncommitted files, the agent's progress notes, time since anything moved); no NAME = every slice: just slice-status [NAME]
slice-status name="":
    python3 -B {{skill}}/scripts/slice.py status {{name}} --root .

# Take the scratch repo's commits into this project (git am), then run the checks here: just slice-merge NAME
slice-merge name:
    python3 -B {{skill}}/scripts/slice.py merge {{name}} --root .

# --- build, check, run: every command takes the phase (1 = phase1/src, byte-identical; 2 = phase2/src, the split source) ---------------------------------------
# `just <command>` works on ACTIVE_PHASE (project.config); `just <command> 1` / `just <command> 2` names it. Phase 2 needs the safety net (tools/golden, tools/tests; references/phase2_split.md).

# Assemble a phase's source (no comparison): phase 1 -> OUTPUT_PRG (project.config), phase 2 -> build/p2/game.prg. The symbol file is left at build/game.sym (build/p2/game.sym).
build phase=active_phase:
    C64_PHASE={{phase}} bash framework/scripts/build.sh

# `build` under its older name (fast iteration, no comparison).
experiment phase=active_phase: (build phase)

# THE GATE: assemble a phase and compare it byte for byte with the reference image. Phase 2 stays byte-identical until the byte-changing removals (step 6).
verify phase=active_phase:
    C64_PHASE={{phase}} bash framework/scripts/verify.sh

# Run a phase in VICE at real speed with its symbols, as the original hand-off left it (project.config LAUNCH_MODE: sys = `sys HANDOFF_PC` on the bare PRG, inject = restore the dumped low RAM and registers through the monitor).
launch phase=active_phase: (build phase)
    #!/usr/bin/env bash
    set -euo pipefail
    extra=(); if [ "{{phase}}" = "2" ]; then extra=(--prg build/p2/game.prg --symbols "$(ls -t build/p2/*.vs | head -1)"); fi
    python3 -B {{skill}}/scripts/launcher/run_game.py --root . ${extra[@]+"${extra[@]}"}

# Unattended start test (about 20 s): boot a phase headless in VICE (warp), screenshot after SMOKE_CYCLES, fail when the game did not start or the picture differs from the reference (tools/smoke_ref.png; the first run creates it: look at it once and commit it).
smoke phase=active_phase: (build phase)
    #!/usr/bin/env bash
    set -euo pipefail
    extra=(); if [ "{{phase}}" = "2" ]; then extra=(--prg build/p2/game.prg); fi
    python3 -B {{skill}}/scripts/launcher/smoke.py --root . ${extra[@]+"${extra[@]}"}

# Routine tests: call routines in the 6510 simulator and compare with Python models (tools/tests/), against a phase's build.
test phase=active_phase: (build phase)
    python3 -B {{skill}}/scripts/sim/run_tests.py --root . --phase {{phase}}

# Golden traces: the program's state per video frame in seeded scenarios (tools/golden/scenarios.txt: `name: tracer args`, `name!:` = exact-only; state.txt, optional GOLDEN_STATE_T; project.config GOLDEN_T_SET = the scenarios of the timing-tolerant set, comma separated).
# Phase 1 is compared exactly and then timing-tolerantly; phase 2 (bytes may change) timing-tolerantly. `just golden-record` records both sets on the PHASE 1 build, only after a deliberate behaviour change.
golden phase=active_phase: (build phase)
    #!/usr/bin/env bash
    set -euo pipefail
    . ./project.config
    only=(); [ -n "${GOLDEN_T_SET:-}" ] && only=(--only "$GOLDEN_T_SET")
    g="python3 -B {{skill}}/scripts/golden/golden.py"
    if [ "{{phase}}" = "1" ]; then $g check --root . --phase 1; fi
    $g check-t --root . --phase {{phase}} ${only[@]+"${only[@]}"}
golden-record: (build "1")
    #!/usr/bin/env bash
    set -euo pipefail
    . ./project.config
    only=(); [ -n "${GOLDEN_T_SET:-}" ] && only=(--only "$GOLDEN_T_SET")
    python3 -B {{skill}}/scripts/golden/golden.py record --root . --phase 1
    python3 -B {{skill}}/scripts/golden/golden.py record-t --root . --phase 1 ${only[@]+"${only[@]}"}

# What would break if the image or a variable moved (reloc_scan: indirect addressing, SMC, jmp (), code as data; reloc_hazards: aligned bases, guards, sprite pointers, file I/O).
reloc phase=active_phase:
    python3 -B {{skill}}/scripts/reloc_scan.py --root . --phase {{phase}}
    python3 -B {{skill}}/scripts/reloc_hazards.py --root . --phase {{phase}}

# Relocation stress test: variants with N bytes inserted (and the same N taken from a dead pad), each run against the baseline (scripts/layout_fuzz.py, scripts/trace/layout_compare.py, references/testing.md).
fuzz-layout *args:
    python3 -B {{skill}}/scripts/layout_fuzz.py --root . {{args}}

# Everything that must stay green, per phase. Phase 1: the byte-identical build, routine tests, golden traces. Phase 2: it assembles (and, until step 6, is byte-identical), no raw operands, comments conform, routine tests, timing-tolerant golden traces.
check phase=active_phase:
    #!/usr/bin/env bash
    set -euo pipefail
    just verify {{phase}}
    if [ "{{phase}}" = "2" ]; then
        python3 -B {{skill}}/scripts/raw_refs.py --root . --phase 2
        python3 -B {{skill}}/scripts/comment_check.py --root . --phase 2
    fi
    just test {{phase}}
    just golden {{phase}}

# Where the project is in the MOSaic process and what comes next (--verify also runs the gate and the phase 1 completeness report). An agent runs this when a stage ends or the user says to go on.
status *args:
    @python3 -B {{skill}}/scripts/status.py --root . {{args}}
