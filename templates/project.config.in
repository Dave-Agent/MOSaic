# project.config - the seam between the generic framework and this project. Shell-sourceable KEY="value", paths relative to the project root.
PROJECT_NAME="@NAME@"

# --- Toolchain ---
KICKASS_JAR="@KICKASS_JAR@"
JAVA="java"
VICE_BIN="x64sc"
# GHIDRA_HOME="~/ghidra/ghidra_x.y_PUBLIC"     # if not under ~/ghidra*/ghidra_*

# --- Source ---
SRC_DIR="phase1/src"
SRC_MAIN="phase1/src/@SLUG@.asm"
SRC_SYMBOLS="phase1/src/symbols.asm"
PHASE2_DIR="phase2/src"
PHASE2_MAIN="phase2/src/@SLUG@.asm"

# --- Reference (the game's RAM at the hand-off; derived from the media, never committed: see README) ---
REFERENCE_PRG="reference/@SLUG@_ref.bin"
REFERENCE_IS_RAW="true"
LOAD_ADDRESS="0x0800"          # first address of the reference image; set it with REF_KEEP below
IGNORE_LOAD_ADDRESS="false"
REF_KEEP="0800-FFFF"           # the address range of the dump that becomes the reference
REF_SPEC="tools/reference.spec"
REF_OUT="reference/@SLUG@_ref.bin"
REF_SHA_FILE="reference.sha256"

# --- Build ---
BUILD_DIR="build"
OUTPUT_PRG="build/@SLUG@_game.prg"
VICE_SYMBOLS="build/@SLUG@.vs"
DEBUG_FILE="build/@SLUG@.dbg"
GHIDRA_EXPORT_DIR="ghidra"

# --- Hand-off derivation (fill these in as the boot analysis finds them: references/new_game.md stages 2-3) ---
HANDOFF_MEDIA="@MEDIA@"        # the medium the dumps are taken from: CHECK IT is the unprotected one (a read-only scratch copy is attached, never this file)
DUMP_PC=""                     # stage 1: RAM is dumped when execution reaches this address (the depacker's entry, or the hand-off itself if nothing is packed)
DUMP_COUNT="5"                 # how many dumps are voted (emulator noise from a timing-critical loader)
DUMP_STEPS=""                  # patches to pass a title/menu that waits for a key or fire: "ADDR=> ADDR EA EA;;ADDR=CMD;CMD" (`;;` separates steps, run in order; references/hand_off_tools.md)
DUMP_FEED=""                   # monitor commands re-sent while waiting, e.g. to poke a key into the keyboard buffer
DECRUNCH_SP="fc"               # tracer start state for the depacker run: SP, processor status, processor port
DECRUNCH_P="34"
DECRUNCH_PORT="34"
HANDOFF_PC=""                  # the tracer stops here (the depacker's exit = the game's entry) and dumps RAM: the reference is that state
# --- Seeds for Ghidra (the game's own behaviour, from the tracer; stage 5) ---
SEED_JOY1=""                   # joystick 1 during the coverage run: empty = random presses (fuzzed: gets past a menu); a value holds it (ff = nothing pressed, ef = fire)
SEED_JOY2=""
SEED_EXTRA=""                  # extra tracer arguments, e.g. "--joy2-at 100=ef --joy2-at 110=ff" (fire pulsed at frame 100). A --joy1-at or --joy2-at switches the fuzzers off.
SEED_FRAMES="6000"
SEED_RUNS="6"

# --- Commits ---
COMMIT_TRAILERS=""             # attribution lines appended by `just commit "msg"`, separated by \n (decided per project and author)

# --- Launch and smoke (scripts/launcher/README.md) ---
LAUNCH_MODE="sys"               # sys: `sys HANDOFF_PC` typed into VICE on the bare PRG (try first); inject: restore dumps/handoff.bin low RAM + registers (HANDOFF_SP/P, LAUNCH_PORT, LAUNCH_POKES) through the monitor
SMOKE_CYCLES="200000000"        # the screenshot is taken after this many cycles in warp (about 20 s per 100 M)
JUDGE_CROP=""                   # X0,Y0,X1,Y1 of something static on the start screen (not a scroller); empty = whole picture

# The phase the bare `just` commands work on (1 = phase1/src, byte-identical; 2 = phase2/src, the split source). Every command also takes it as an argument: `just verify 1`.
# A slice can be reviewed by a second agent (the Challenger, references/challenger.md) before it merges: required = `just slice-merge` refuses without a passing review record for the diff; off = no review (the default: OPT IN). A review costs tokens: about 30,000 for a slice that introduces no names, plus about 4,000 for each name it tests (measured: 33,000 for a small slice, 156,000 and 8 minutes for one that tested 28 names), so a project of several large slices is on the order of a million. The agent asks once, at the start of phase 1, and sets this to what the user says.
SLICE_REVIEW="off"
# The most names the reviewer tests per slice (0 = no cap): it bounds the cost, about 30,000 + 4,000 per name (12 names: about 80,000 tokens). `just review-risk NAME` shows what a slice would cost before any tokens are spent.
SLICE_REVIEW_MAX_CLAIMS="12"
ACTIVE_PHASE="1"
# Phase 2 safety net: the scenarios of the timing-tolerant golden set (comma separated; the others are exact-only). Empty = all.
GOLDEN_T_SET=""

# Phase 2 byte-changing steps: the PATH OF A FILE of C64 address ranges (hex LO-HI, one per line, # comments, e.g. docs/phase2_allowed_diff.txt) in which the phase 2 image may differ from the reference on purpose (removed dead blocks, rewritten operands); `just verify 2` fails on a changed byte anywhere else. Empty/unset = byte-identical.
PHASE2_ALLOWED_DIFF=""

# Unattended VICE runs (dumps, hand-off, smoke test) must not take the desktop focus: minimized (default) | xvfb (a virtual display through xvfb-run: no window at all; apt install xvfb) | normal (a plain window, to watch a run). `just launch` is interactive and always a normal window.
VICE_DISPLAY="minimized"

# Unattended start test: how many times `just smoke` tries before it fails (1 = once). A program whose ORIGINAL start is flaky (a race, or state a loader left in low RAM that the program reads) needs more than 1; a pass after failed attempts says so and is not hidden.
SMOKE_RETRIES="1"
